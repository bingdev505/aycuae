---
import { querySanity, urlFor } from '../utils/sanity';

const aboutSectionQuery = `*[_type == "aboutSection"][0]{
  badgeTitle,
  badgeSubtitle,
  title,
  description,
  featuresList,
  youtubeUrl,
  image
}`;

const defaultAbout = {
  badgeTitle: '25+',
  badgeSubtitle: 'Years of Experience',
  title: 'We are Professional Builders and Contractors since 1996',
  description: 'With over three decades of building and construction engineering experience, we design and construct residential, commercial, and industrial facilities. We pride ourselves on engineering safety, building durability, and premium finishes.',
  featuresList: [
    'Certified structural engineers & planners',
    'Premium quality raw materials and modern tools',
    'Accurate blueprints and cost estimation',
    'On-time delivery and strict adherence to deadlines'
  ],
  youtubeUrl: 'https://www.youtube.com/watch?v=Y-x0efG1seA',
  image: null
};

const about = await querySanity(aboutSectionQuery, defaultAbout);
const imageUrl = about.image ? urlFor(about.image) : '/wp-content/uploads/2025/11/about-img.jpg';
---

<section class="about-area" id="about">
  <div class="container">
    <div class="row align-items-center">
      <!-- Image Column -->
      <div class="col-lg-6 col-12 mb-5 mb-lg-0">
        <div class="about-img-box">
          <div class="about-main-img">
            <img src={imageUrl} alt="About Us" class="img-fluid rounded-4" />
          </div>
          <!-- Video play trigger inside image -->
          <div class="about-video-btn">
            <a class="video-btn-play popup-youtube" href={about.youtubeUrl} aria-label="Play video">
              <i class="fas fa-play"></i>
            </a>
          </div>
          <!-- Rotating Badge Overlay -->
          <div class="about-experience-badge">
            <div class="badge-content">
              <h3>{about.badgeTitle}</h3>
              <p>{about.badgeSubtitle}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Text / Content Column -->
      <div class="col-lg-6 col-12 ps-lg-5">
        <div class="about-content">
          <div class="section-title-box">
            <span class="sub-heading">About Our Company</span>
            <h2 class="main-heading">{about.title}</h2>
          </div>
          <p class="about-description">{about.description}</p>

          <!-- Accordion list -->
          <div class="about-accordion" id="aboutAccordion">
            <div class="accordion-card active">
              <div class="accordion-header" id="headingOne">
                <button class="accordion-btn" type="button">
                  <span>Our Professional Mission</span>
                  <i class="fa-solid fa-plus icon-toggle"></i>
                </button>
              </div>
              <div class="accordion-collapse">
                <div class="accordion-body">
                  Our mission is to lead the building contractor industry with high safety standards, state-of-the-art architectures, and transparent pricing.
                </div>
              </div>
            </div>

            <div class="accordion-card">
              <div class="accordion-header" id="headingTwo">
                <button class="accordion-btn" type="button">
                  <span>Eco-Friendly Engineering Standards</span>
                  <i class="fa-solid fa-plus icon-toggle"></i>
                </button>
              </div>
              <div class="accordion-collapse">
                <div class="accordion-body">
                  We actively utilize eco-friendly construction materials and sustainable energy architectures to reduce environmental footprints.
                </div>
              </div>
            </div>

            <div class="accordion-card">
              <div class="accordion-header" id="headingThree">
                <button class="accordion-btn" type="button">
                  <span>Guaranteed Quality Assurance</span>
                  <i class="fa-solid fa-plus icon-toggle"></i>
                </button>
              </div>
              <div class="accordion-collapse">
                <div class="accordion-body">
                  Every phase of construction undergoes double-layer quality audits from external certified engineers to guarantee safety.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-area {
    padding: 100px 0;
    background: #090d16;
    color: white;
  }

  .about-img-box {
    position: relative;
  }

  .about-main-img img {
    width: 100%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .about-video-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .video-btn-play {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #ff6900;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 18px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .video-btn-play:hover {
    background: white;
    color: #ff6900;
    transform: scale(1.1);
  }

  .about-experience-badge {
    position: absolute;
    bottom: -30px;
    right: -30px;
    background: #ff6900;
    color: white;
    padding: 25px 30px;
    border-radius: 20px;
    max-width: 200px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(255, 105, 0, 0.3);
  }

  .badge-content h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 38px;
    font-weight: 700;
    margin: 0;
  }

  .badge-content p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    margin: 5px 0 0;
    line-height: 1.3;
  }

  /* Content Column */
  .sub-heading {
    font-family: 'Space Grotesk', sans-serif;
    color: #ff6900;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 15px;
  }

  .main-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.2;
    color: white;
    margin-bottom: 25px;
  }

  .about-description {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 35px;
  }

  /* Accordion styles */
  .about-accordion {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .accordion-card {
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
  }

  .accordion-card.active {
    border-color: #ff6900;
  }

  .accordion-btn {
    width: 100%;
    background: none;
    border: none;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 18px;
    cursor: pointer;
    text-align: left;
  }

  .accordion-collapse {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .accordion-card.active .accordion-collapse {
    max-height: 200px;
  }

  .accordion-body {
    padding: 0 20px 20px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .icon-toggle {
    transition: transform 0.3s ease;
  }

  .accordion-card.active .icon-toggle {
    transform: rotate(45deg);
    color: #ff6900;
  }

  @media (max-width: 991px) {
    .about-experience-badge {
      position: static;
      margin: 30px auto 0;
    }
    .main-heading {
      font-size: 32px;
    }
  }
</style>

<script>
  const accordionCards = document.querySelectorAll('.accordion-card');
  accordionCards.forEach(card => {
    const btn = card.querySelector('.accordion-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const isActive = card.classList.contains('active');
        accordionCards.forEach(c => c.classList.remove('active'));
        if (!isActive) {
          card.classList.add('active');
        }
      });
    }
  });
</script>
