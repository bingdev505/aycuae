---
import { siteData } from '../data/siteData';

const posts = siteData.blog;
---

<section class="blog-area" id="blog">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="sub-heading">Articles & News</span>
      <h2 class="main-heading text-white">Latest Construction Guides</h2>
    </div>

    <div class="row">
      {posts.map((post) => {
        return (
          <div class="col-lg-4 col-md-6 col-12 mb-4">
            <article class="blog-card-item">
              <div class="blog-photo-box">
                <img src={post.coverImage} alt={post.title} class="img-fluid" />
                <span class="blog-date-badge">{post.publishDate}</span>
              </div>
              <div class="blog-info-box">
                <h3 class="blog-card-title"><a href="#contact">{post.title}</a></h3>
                <p class="blog-card-excerpt">{post.excerpt}</p>
                <a href="#contact" class="blog-read-more-btn">
                  <span>Read Article</span>
                  <i class="fa-solid fa-arrow-right-long"></i>
                </a>
              </div>
            </article>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .blog-area {
    padding: 100px 0;
    background: #090d16;
  }

  .blog-card-item {
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
  }

  .blog-card-item:hover {
    transform: translateY(-5px);
    border-color: #ff6900;
  }

  .blog-photo-box {
    position: relative;
    overflow: hidden;
  }

  .blog-photo-box img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card-item:hover .blog-photo-box img {
    transform: scale(1.05);
  }

  .blog-date-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: #ff6900;
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 13px;
    padding: 6px 15px;
    border-radius: 30px;
  }

  .blog-info-box {
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
    margin: 0 0 15px 0;
  }

  .blog-card-title a {
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .blog-card-title a:hover {
    color: #ff6900;
  }

  .blog-card-excerpt {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 25px;
    flex-grow: 1;
  }

  .blog-read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .blog-read-more-btn i {
    transition: transform 0.3s ease;
  }

  .blog-read-more-btn:hover {
    color: #ff6900;
  }

  .blog-read-more-btn:hover i {
    transform: translateX(5px);
  }
</style>
