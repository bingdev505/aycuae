---
import { querySanity } from '../utils/sanity';

const featureCardsQuery = `*[_type == "featureCard"]{
  title,
  description,
  icon,
  colorStyle
}`;

const defaultCards = [
  {
    title: 'DesignBuild',
    description: 'Shaping the future of design',
    icon: '01',
    colorStyle: 'orange'
  },
  {
    title: 'Modern Renovation',
    description: 'Bespoke high-end custom building solutions',
    icon: '02',
    colorStyle: 'orange'
  },
  {
    title: 'Interior Design',
    description: 'Aesthetic spaces tailored to modern lifestyle',
    icon: '03',
    colorStyle: 'orange'
  }
];

const cards = await querySanity(featureCardsQuery, defaultCards);
---

<section class="features-area">
  <div class="container">
    <div class="features-wrapper">
      <div class="row">
        {cards.map((card) => (
          <div class="col-lg-4 col-md-6 col-12 mb-4 mb-lg-0">
            <div class="feature-item">
              <div class="feature-item-header">
                <span class="feature-label">{card.title}</span>
                <span class="feature-number">{card.icon}</span>
              </div>
              <h3 class="feature-title">{card.description}</h3>
              <div class="feature-btn">
                <a href="#contact" class="btn-arrow" aria-label="Learn more">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="currentColor">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M16.8065 5.82872C14.3962 5.82872 12.1995 3.54151 12.1995 1.02981V0L10.2223 0V1.02981C10.2223 2.85669 10.9914 4.57028 12.1985 5.82872L0 5.82872L0 7.88833L12.1985 7.88833C10.9914 9.14676 10.2223 10.8604 10.2223 12.6872V13.717H12.1995V12.6872C12.1995 10.1755 14.3962 7.88833 16.8065 7.88833H17.7951V5.82872H16.8065Z"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .features-area {
    position: relative;
    z-index: 10;
    margin-top: -60px;
    padding-bottom: 50px;
  }

  .feature-item {
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 35px 30px;
    border-radius: 20px;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .feature-item:hover {
    transform: translateY(-5px);
    border-color: #ff6900;
    background: #192231;
  }

  .feature-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .feature-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #ff6900;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .feature-number {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.1);
  }

  .feature-item:hover .feature-number {
    color: #ff6900;
  }

  .feature-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    color: white;
    margin-bottom: 30px;
  }

  .btn-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: white;
    transition: all 0.3s ease;
  }

  .feature-item:hover .btn-arrow {
    background: #ff6900;
    color: white;
    transform: rotate(-45deg);
  }

  @media (max-width: 991px) {
    .features-area {
      margin-top: 0;
      padding-top: 50px;
    }
  }
</style>
