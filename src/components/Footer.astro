---
import { querySanity, urlFor } from '../utils/sanity';

const siteSettingsQuery = `*[_type == "siteSettings"][0]{
  siteTitle,
  phone,
  email,
  address,
  footerAbout,
  logo
}`;

const defaultSettings = {
  siteTitle: 'Renovex',
  phone: '+0044 9922299',
  email: 'info@renovex.com',
  address: '22 Sterling Close, Winchester, W23 4FD',
  footerAbout: 'Renovex is a premium construction, building, and renovation contractor offering high-quality architectural, design, and remodeling solutions.',
  logo: null
};

const settings = await querySanity(siteSettingsQuery, defaultSettings);
const logoUrl = settings.logo ? urlFor(settings.logo) : '/wp-content/uploads/2025/11/logo.svg';
---

<footer class="footer-section" id="contact">
  <div class="container footer-top">
    <div class="row">
      <!-- About / Branding Column -->
      <div class="col-lg-4 col-md-6 col-12 mb-5 mb-lg-0">
        <div class="footer-about-box">
          <div class="footer-logo mb-4">
            <img src={logoUrl} alt={settings.siteTitle} class="img-fluid" />
          </div>
          <p class="footer-desc-text">{settings.footerAbout}</p>
          <div class="footer-contact-details mt-4">
            <div class="contact-info-item">
              <div class="contact-icon"><i class="fa-solid fa-location-dot"></i></div>
              <div class="contact-text">
                <span class="contact-label">Address:</span>
                <p>{settings.address}</p>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="contact-icon"><i class="fa-solid fa-phone"></i></div>
              <div class="contact-text">
                <span class="contact-label">Phone:</span>
                <p><a href={`tel:${settings.phone}`}>{settings.phone}</a></p>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="contact-icon"><i class="fa-solid fa-envelope"></i></div>
              <div class="contact-text">
                <span class="contact-label">Email:</span>
                <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Links Column -->
      <div class="col-lg-2 col-md-6 col-12 mb-5 mb-lg-0 ps-lg-5">
        <div class="footer-links-box">
          <h3 class="footer-col-title">Quick Links</h3>
          <ul class="footer-menu-links">
            <li><a href="/">Home</a></li>
            <li><a href="#about">About Us</a></li>
            <li><a href="#services">Our Services</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#testimonials">Testimonials</a></li>
          </ul>
        </div>
      </div>

      <!-- Newsletter Column -->
      <div class="col-lg-4 col-md-6 col-12 mb-5 mb-lg-0">
        <div class="footer-newsletter-box">
          <h3 class="footer-col-title">Newsletter</h3>
          <p class="newsletter-desc">Stay updated on our latest projects, tips, and offers.</p>
          <form class="footer-newsletter-form" onsubmit="event.preventDefault()">
            <input type="email" placeholder="Enter Email Address*" required />
            <button type="submit" class="btn-subscribe">
              <i class="fa-solid fa-arrow-right-long"></i>
            </button>
          </form>
          <div class="footer-social-shares mt-4">
            <h4 class="social-share-title">Follow On Socials:</h4>
            <div class="social-btn-group">
              <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
              <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
              <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
              <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright Bottom -->
  <div class="footer-bottom-bar">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6 col-12 text-center text-md-start">
          <p class="copyright-text">Copyright &copy; {new Date().getFullYear()} <a href="/">{settings.siteTitle}</a>. All rights reserved.</p>
        </div>
        <div class="col-md-6 col-12 text-center text-md-end mt-3 mt-md-0">
          <div class="footer-bottom-links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Service</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    background: #090d16;
    color: white;
    padding-top: 100px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-top {
    padding-bottom: 70px;
  }

  .footer-desc-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .contact-info-item {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
  }

  .contact-icon {
    font-size: 20px;
    color: #ff6900;
  }

  .contact-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #ff6900;
    text-transform: uppercase;
    display: block;
    margin-bottom: 3px;
  }

  .contact-text p {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .contact-text a {
    color: inherit;
    text-decoration: none;
  }

  .contact-text a:hover {
    color: #ff6900;
  }

  /* Column Titles */
  .footer-col-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 20px;
    color: white;
    margin-bottom: 30px;
  }

  .footer-menu-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-menu-links a {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .footer-menu-links a:hover {
    color: #ff6900;
    padding-left: 5px;
  }

  /* Newsletter Column */
  .newsletter-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 20px;
  }

  .footer-newsletter-form {
    position: relative;
    display: flex;
  }

  .footer-newsletter-form input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    padding: 15px 60px 15px 25px;
    color: white;
    font-family: 'DM Sans', sans-serif;
    outline: none;
  }

  .btn-subscribe {
    position: absolute;
    right: 5px;
    top: 5px;
    bottom: 5px;
    width: 48px;
    background: #ff6900;
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .btn-subscribe:hover {
    background: white;
    color: #ff6900;
  }

  /* Social Links */
  .social-share-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: white;
    margin-bottom: 15px;
  }

  .social-btn-group {
    display: flex;
    gap: 12px;
  }

  .social-btn-group a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-btn-group a:hover {
    background: #ff6900;
    color: white;
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    background: #060910;
    padding: 30px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .copyright-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .copyright-text a {
    color: white;
    text-decoration: none;
  }

  .copyright-text a:hover {
    color: #ff6900;
  }

  .footer-bottom-links a {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    margin-left: 20px;
    transition: all 0.3s ease;
  }

  .footer-bottom-links a:hover {
    color: #ff6900;
  }
</style>
