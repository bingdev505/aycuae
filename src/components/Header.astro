---
import { siteData } from '../data/siteData';

const settings = siteData.settings;
---

<header class="main-header">
  <div class="header-version-1">
    <div class="container header-container">
      <!-- Logo -->
      <div class="logo-box">
        <a href="/" class="site-logo">
          <img src={settings.logo} alt={settings.siteTitle} class="default-logo" />
        </a>
      </div>

      <!-- Navigation Menu -->
      <nav class="nav-menu-wrapper">
        <button class="menu-hamburger" aria-label="Toggle Menu" id="mobileMenuTrigger">
          <i class="fa-solid fa-bars"></i>
        </button>
        <ul class="nav-menu" id="headerNavMenu">
          <li class="menu-item"><a href="/" class="active">Home</a></li>
          <li class="menu-item"><a href="/about-us">About Us</a></li>
          <li class="menu-item"><a href="/services">Services</a></li>
          <li class="menu-item"><a href="/projects">Projects</a></li>
          <li class="menu-item"><a href="/testimonials">Testimonials</a></li>
          <li class="menu-item"><a href="/our-team">Our Team</a></li>
          <li class="menu-item"><a href="/blog">Blog</a></li>
        </ul>
      </nav>

      <!-- Action Button -->
      <div class="header-action-btn">
        <a href="/contact-us" class="btn-get-in-touch">
          <span>Get In Touch</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M16.8065 5.82872C14.3962 5.82872 12.1995 3.54151 12.1995 1.02981V0L10.2223 0V1.02981C10.2223 2.85669 10.9914 4.57028 12.1985 5.82872L0 5.82872L0 7.88833L12.1985 7.88833C10.9914 9.14676 10.2223 10.8604 10.2223 12.6872V13.717H12.1995V12.6872C12.1995 10.1755 14.3962 7.88833 16.8065 7.88833H17.7951V5.82872H16.8065Z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .main-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    padding: 20px 0;
    background: transparent;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 15px 30px;
    border-radius: 50px;
  }

  .logo-box img {
    height: 38px;
    display: block;
  }

  .nav-menu {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 30px;
  }

  .menu-hamburger {
    display: none;
    background: none;
    border: none;
    color: white;
    font-size: 24px;
    cursor: pointer;
  }

  .nav-menu a {
    color: #ffffff;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: 16px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    letter-spacing: 0.5px;
    text-decoration: none;
  }

  .nav-menu a:hover,
  .nav-menu a.active {
    color: #ff6900;
  }

  .btn-get-in-touch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ff6900;
    color: white;
    padding: 12px 25px;
    border-radius: 30px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 14px;
    transition: all 0.3s ease;
    border: none;
    text-decoration: none;
  }

  .btn-get-in-touch svg {
    transition: transform 0.3s ease;
  }

  .btn-get-in-touch:hover {
    background: white;
    color: #1a1a1a;
  }

  .btn-get-in-touch:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    .menu-hamburger {
      display: block;
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: #111;
      flex-direction: column;
      padding: 20px;
      gap: 15px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .nav-menu.active {
      display: flex;
    }

    .header-action-btn {
      display: none;
    }
  }
</style>

<script>
  const mobileMenuTrigger = document.getElementById('mobileMenuTrigger');
  const headerNavMenu = document.getElementById('headerNavMenu');

  if (mobileMenuTrigger && headerNavMenu) {
    mobileMenuTrigger.addEventListener('click', () => {
      headerNavMenu.classList.toggle('active');
    });

    const links = headerNavMenu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        headerNavMenu.classList.remove('active');
      });
    });
  }
</script>
