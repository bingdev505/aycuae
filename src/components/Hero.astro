---
import { querySanity, urlFor } from '../utils/sanity';

const heroSlidesQuery = `*[_type == "heroSlide"][0]{
  subtitle,
  title,
  description,
  buttonText,
  buttonUrl,
  bgImage
}`;

const defaultHero = {
  subtitle: 'WHERE CREATIVITY MEETS STRUCTURAL MASTERY',
  title: 'Where innovative design meet precision construction to create spaces that inspire and endure',
  description: 'Our approach unites visionary architecture with flawless construction execution. From concept to completion, we build environments that tell a story of innovation, precision, and enduring quality.',
  buttonText: 'Get Free Estimate',
  buttonUrl: '#contact',
  bgImage: null
};

const hero = await querySanity(heroSlidesQuery, defaultHero);
const bgUrl = hero.bgImage ? urlFor(hero.bgImage) : '/wp-content/uploads/2025/11/hero-bg.jpg';
---

<section class="hero-area" style={`background-image: url(${bgUrl});`}>
  <div class="container hero-container">
    <div class="row align-items-center">
      <div class="col-lg-8 col-md-12">
        <div class="hero-content">
          <span class="hero-sub-title">{hero.subtitle}</span>
          <h1 class="hero-main-title">{hero.title}</h1>
          <p class="hero-desc">{hero.description}</p>
          
          <div class="hero-actions">
            <a href={hero.buttonUrl} class="btn-estimate">
              <span>{hero.buttonText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16.8065 5.82872C14.3962 5.82872 12.1995 3.54151 12.1995 1.02981V0L10.2223 0V1.02981C10.2223 2.85669 10.9914 4.57028 12.1985 5.82872L0 5.82872L0 7.88833L12.1985 7.88833C10.9914 9.14676 10.2223 10.8604 10.2223 12.6872V13.717H12.1995V12.6872C12.1995 10.1755 14.3962 7.88833 16.8065 7.88833H17.7951V5.82872H16.8065Z"></path>
              </svg>
            </a>
            
            <div class="hero-video-box">
              <a class="video-btn popup-youtube" href="https://www.youtube.com/watch?v=Y-x0efG1seA" aria-label="Play video">
                <i class="fas fa-play"></i>
              </a>
              <span class="video-text">Watch Our Video</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Rotating Experience Circle -->
      <div class="col-lg-4 col-md-12 text-center d-none d-lg-block">
        <div class="experience-circle-box">
          <div class="rotating-text-wrapper">
            <svg viewBox="0 0 200 200" width="200" height="200" class="rotating-svg">
              <path id="circlePath" d="M 100, 100 m -75, 0 a 75,75 0 1,1 150,0 a 75,75 0 1,1 -150,0" fill="none"></path>
              <text fill="white" font-size="14" font-family="'Space Grotesk', sans-serif" letter-spacing="4px">
                <textPath href="#circlePath">25+ Years Experience * 25+ Years Experience *</textPath>
              </text>
            </svg>
            <div class="experience-years">25+</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-area {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 220px 0 150px;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .hero-area::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(9, 13, 22, 0.9) 0%, rgba(9, 13, 22, 0.7) 100%);
    z-index: -1;
  }

  .hero-sub-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 2px;
    color: #ff6900;
    text-transform: uppercase;
    display: block;
    margin-bottom: 20px;
  }

  .hero-main-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 56px;
    line-height: 1.15;
    color: white;
    margin-bottom: 25px;
  }

  .hero-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 40px;
    max-width: 680px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .btn-estimate {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ff6900;
    color: white;
    padding: 16px 35px;
    border-radius: 30px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 14px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .btn-estimate svg {
    transition: transform 0.3s ease;
  }

  .btn-estimate:hover {
    background: white;
    color: #1a1a1a;
  }

  .btn-estimate:hover svg {
    transform: translateX(3px);
  }

  .hero-video-box {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .video-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #ff6900;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 16px;
    position: relative;
    z-index: 1;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .video-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #ff6900;
    opacity: 0.5;
    z-index: -1;
    animation: ripple 1.5s infinite ease-in-out;
  }

  .video-btn:hover {
    background: white;
    color: #ff6900;
  }

  .video-text {
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 16px;
  }

  /* Rotating Circle */
  .experience-circle-box {
    position: relative;
    display: inline-block;
  }

  .rotating-text-wrapper {
    position: relative;
    width: 200px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rotating-svg {
    animation: rotateText 15s linear infinite;
  }

  .experience-years {
    position: absolute;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 36px;
    color: #ff6900;
  }

  @keyframes rotateText {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes ripple {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  @media (max-width: 991px) {
    .hero-main-title {
      font-size: 42px;
    }
    .hero-desc {
      font-size: 16px;
    }
  }

  @media (max-width: 575px) {
    .hero-actions {
      gap: 20px;
    }
  }
</style>
