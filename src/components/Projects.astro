---
import { querySanity, urlFor } from '../utils/sanity';

const projectsQuery = `*[_type == "project"]{
  title,
  "slug": slug.current,
  category,
  image
}`;

const defaultProjects = [
  {
    title: 'Modern Residential Complex',
    category: 'Building',
    slug: 'modern-residential',
    image: null
  },
  {
    title: 'Skyline Business Tower',
    category: 'Architecture',
    slug: 'skyline-business-tower',
    image: null
  },
  {
    title: 'Industrial Factory Plant',
    category: 'Infrastructure',
    slug: 'industrial-factory-plant',
    image: null
  },
  {
    title: 'Luxury Eco Villa',
    category: 'Renovation',
    slug: 'luxury-eco-villa',
    image: null
  }
];

const projects = await querySanity(projectsQuery, defaultProjects);
---

<section class="section projects-section" id="projects">
  <div class="container">
    <div class="section-title-wrapper">
      <span class="section-subtitle">Our Portfolios</span>
      <h2 class="section-title">Explore Recent Projects</h2>
    </div>

    <!-- Swiper slider for projects -->
    <div class="swiper projects-swiper">
      <div class="swiper-wrapper">
        {projects.map((project) => {
          const imgUrl = project.image ? urlFor(project.image) : 'https://images.unsplash.com/photo-1590381105924-c72589b9ef3f?auto=format&fit=crop&w=600&q=80';
          return (
            <div class="swiper-slide project-slide">
              <div class="project-card">
                <img src={imgUrl} alt={project.title} />
                <div class="project-overlay">
                  <span class="project-category">{project.category}</span>
                  <h3 class="project-title">{project.title}</h3>
                  <a href="#contact" class="project-link" aria-label="View Details">
                    <span class="arrow-icon">→</span>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      
      <!-- Controls -->
      <div class="swiper-pagination projects-pagination"></div>
    </div>
  </div>
</section>

<style>
  .projects-section {
    background-color: var(--bg-light-card);
  }

  .projects-swiper {
    padding-bottom: 50px;
    width: 100%;
  }

  .project-slide {
    height: 400px;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
  }

  .project-card {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .project-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
  }

  .project-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.9) 20%, rgba(15, 23, 42, 0.2) 80%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 30px;
    opacity: 0;
    transition: var(--transition-smooth);
    transform: translateY(10px);
  }

  .project-card:hover .project-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card:hover img {
    transform: scale(1.05);
  }

  .project-category {
    font-family: var(--font-heading);
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 22px;
    color: white;
    font-weight: 700;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .project-link {
    width: 45px;
    height: 45px;
    background-color: var(--color-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
  }

  .project-link:hover {
    background-color: var(--color-accent);
  }

  .arrow-icon {
    font-size: 18px;
    font-weight: 700;
  }

  .projects-pagination {
    bottom: 0 !important;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    new Swiper('.projects-swiper', {
      slidesPerView: 1,
      spaceBetween: 30,
      loop: true,
      autoplay: {
        delay: 4000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.projects-pagination',
        clickable: true,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 3,
        }
      }
    });
  });
</script>
