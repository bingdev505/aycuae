---
import { siteData } from '../data/siteData';

const projects = siteData.projects;
---

<section class="portfolio-area" id="projects">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="sub-heading">Our Portfolios</span>
      <h2 class="main-heading text-white">Explore Recent Projects</h2>
    </div>

    <!-- Swiper Carousel -->
    <div class="swiper projects-swiper">
      <div class="swiper-wrapper">
        {projects.map((project) => {
          return (
            <div class="swiper-slide">
              <div class="portfolio-card">
                <div class="portfolio-img">
                  <img src={project.image} alt={project.title} class="img-fluid" />
                </div>
                <div class="portfolio-content">
                  <span class="portfolio-cat">{project.category}</span>
                  <h3 class="portfolio-title">{project.title}</h3>
                  <a href="/contact-us" class="portfolio-link-btn" aria-label="View Project">
                    <i class="fa-solid fa-arrow-right-long"></i>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <!-- Pagination -->
      <div class="swiper-pagination projects-pagination-dots"></div>
    </div>
  </div>
</section>

<style>
  .portfolio-area {
    padding: 100px 0;
    background: #090d16;
  }

  .portfolio-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .portfolio-img img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .portfolio-card:hover .portfolio-img img {
    transform: scale(1.08);
  }

  .portfolio-content {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(21, 28, 40, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 25px;
    border-radius: 15px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
  }

  .portfolio-cat {
    font-family: 'Space Grotesk', sans-serif;
    color: #ff6900;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 5px;
    display: block;
  }

  .portfolio-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 20px;
    color: white;
    margin: 0 0 15px 0;
  }

  .portfolio-link-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: #ff6900;
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .portfolio-link-btn:hover {
    background: white;
    color: #ff6900;
  }

  .projects-pagination-dots {
    position: relative;
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    new Swiper('.projects-swiper', {
      slidesPerView: 1,
      spaceBetween: 30,
      loop: true,
      autoplay: {
        delay: 4000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.projects-pagination-dots',
        clickable: true,
      },
      breakpoints: {
        768: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 3,
        }
      }
    });
  });
</script>
