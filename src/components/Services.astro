---
import { siteData } from '../data/siteData';

const services = siteData.services;
---

<section class="services-area" id="services">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="sub-heading">What We Do</span>
      <h2 class="main-heading text-white">Our Premium Services</h2>
    </div>

    <div class="row">
      {services.map((service) => {
        const bgUrl = '/wp-content/uploads/2025/11/service-bg.jpg';
        return (
          <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="service-item-card" style={`background-image: linear-gradient(rgba(21, 28, 40, 0.9), rgba(21, 28, 40, 0.9)), url(${bgUrl});`}>
              <div class="service-icon-box">
                <i class={service.icon || 'fa-solid fa-helmet-safety'}></i>
              </div>
              <h3 class="service-card-title">{service.title}</h3>
              <p class="service-card-desc">{service.description}</p>
              <div class="service-card-footer">
                <a href="/contact-us" class="read-more-btn">
                  <span>Read More</span>
                  <i class="fa-solid fa-arrow-right-long"></i>
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services-area {
    padding: 100px 0;
    background: #090d16;
  }

  .section-title-box {
    margin-bottom: 50px;
  }

  .sub-heading {
    font-family: 'Space Grotesk', sans-serif;
    color: #ff6900;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 15px;
  }

  .main-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 25px;
  }

  .service-item-card {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 40px 30px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
  }

  .service-item-card:hover {
    transform: translateY(-5px);
    border-color: #ff6900;
  }

  .service-icon-box {
    width: 60px;
    height: 60px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #ff6900;
    margin-bottom: 25px;
    transition: all 0.3s ease;
  }

  .service-item-card:hover .service-icon-box {
    background: #ff6900;
    color: white;
  }

  .service-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 22px;
    color: white;
    margin-bottom: 15px;
  }

  .service-card-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 25px;
    flex-grow: 1;
  }

  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .read-more-btn i {
    transition: transform 0.3s ease;
  }

  .read-more-btn:hover {
    color: #ff6900;
  }

  .read-more-btn:hover i {
    transform: translateX(5px);
  }

  @media (max-width: 991px) {
    .main-heading {
      font-size: 32px;
    }
  }
</style>
