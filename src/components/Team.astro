---
import { siteData } from '../data/siteData';

const team = siteData.team;
---

<section class="team-area" id="team">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="sub-heading">Our Experts</span>
      <h2 class="main-heading text-white">Meet Our Leadership</h2>
    </div>

    <div class="row">
      {team.map((member, index) => {
        const profileImg = `/wp-content/uploads/2025/11/team-${index + 1}.jpg`;
        return (
          <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="team-member-card">
              <div class="member-photo-box">
                <img src={profileImg} alt={member.name} class="img-fluid" />
                <div class="member-social-shares">
                  {member.facebookUrl && <a href={member.facebookUrl} class="social-share-btn"><i class="fab fa-facebook-f"></i></a>}
                  {member.twitterUrl && <a href={member.twitterUrl} class="social-share-btn"><i class="fab fa-twitter"></i></a>}
                  {member.instagramUrl && <a href={member.instagramUrl} class="social-share-btn"><i class="fab fa-instagram"></i></a>}
                </div>
              </div>
              <div class="member-info-box">
                <h3 class="member-title-name">{member.name}</h3>
                <span class="member-role-title">{member.role}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .team-area {
    padding: 100px 0;
    background: #090d16;
  }

  .team-member-card {
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s ease;
    text-align: center;
  }

  .team-member-card:hover {
    transform: translateY(-5px);
    border-color: #ff6900;
  }

  .member-photo-box {
    position: relative;
    overflow: hidden;
  }

  .member-photo-box img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .team-member-card:hover .member-photo-box img {
    transform: scale(1.05);
  }

  .member-social-shares {
    position: absolute;
    bottom: -50px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(21, 28, 40, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 10px 20px;
    border-radius: 30px;
    display: flex;
    gap: 15px;
    transition: all 0.3s ease;
    opacity: 0;
  }

  .team-member-card:hover .member-social-shares {
    bottom: 20px;
    opacity: 1;
  }

  .social-share-btn {
    color: white;
    font-size: 14px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-share-btn:hover {
    color: #ff6900;
  }

  .member-info-box {
    padding: 25px 20px;
  }

  .member-title-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 20px;
    color: white;
    margin: 0 0 5px 0;
  }

  .member-role-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: #ff6900;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 1px;
  }
</style>
