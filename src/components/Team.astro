---
import { querySanity, urlFor } from '../utils/sanity';

const teamQuery = `*[_type == "teamMember"]{
  name,
  role,
  facebookUrl,
  twitterUrl,
  instagramUrl,
  image
}`;

const defaultTeam = [
  {
    name: 'Robert Carter',
    role: 'Chief Architect',
    facebookUrl: '#',
    twitterUrl: '#',
    instagramUrl: '#',
    image: null
  },
  {
    name: 'Alex Martinez',
    role: 'Site Supervisor',
    facebookUrl: '#',
    twitterUrl: '#',
    instagramUrl: '#',
    image: null
  },
  {
    name: 'Michael Chen',
    role: 'Structural Engineer',
    facebookUrl: '#',
    twitterUrl: '#',
    instagramUrl: '#',
    image: null
  }
];

const team = await querySanity(teamQuery, defaultTeam);
---

<section class="section team-section" id="team">
  <div class="container">
    <div class="section-title-wrapper">
      <span class="section-subtitle">Our Experts</span>
      <h2 class="section-title">Meet Our Leadership</h2>
    </div>

    <div class="grid grid-3 team-grid">
      {team.map((member) => {
        const profileImg = member.image ? urlFor(member.image) : 'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=400&q=80';
        return (
          <div class="team-card">
            <div class="card-image">
              <img src={profileImg} alt={member.name} />
              <!-- Hover Socials Overlay -->
              <div class="socials-overlay">
                <div class="social-icons">
                  {member.facebookUrl && <a href={member.facebookUrl} class="social-icon">FB</a>}
                  {member.twitterUrl && <a href={member.twitterUrl} class="social-icon">TW</a>}
                  {member.instagramUrl && <a href={member.instagramUrl} class="social-icon">IG</a>}
                </div>
              </div>
            </div>
            <div class="card-body">
              <h3 class="member-name">{member.name}</h3>
              <span class="member-role">{member.role}</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .team-section {
    background-color: var(--bg-light-card);
  }

  .team-grid {
    margin-top: 20px;
  }

  .team-card {
    background-color: var(--bg-light);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02);
    transition: var(--transition-smooth);
    text-align: center;
  }

  .team-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--box-shadow-premium);
  }

  .card-image {
    position: relative;
    height: 350px;
    width: 100%;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
  }

  .team-card:hover .card-image img {
    transform: scale(1.05);
  }

  .socials-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 23, 42, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition-smooth);
  }

  .team-card:hover .socials-overlay {
    opacity: 1;
  }

  .social-icons {
    display: flex;
    gap: 12px;
    transform: translateY(20px);
    transition: var(--transition-smooth);
  }

  .team-card:hover .social-icons {
    transform: translateY(0);
  }

  .social-icon {
    width: 40px;
    height: 40px;
    background-color: var(--color-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    transition: var(--transition-smooth);
  }

  .social-icon:hover {
    background-color: var(--color-accent);
    transform: scale(1.1);
  }

  .card-body {
    padding: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  .member-name {
    font-family: var(--font-heading);
    font-size: 18px;
    color: var(--color-secondary);
    font-weight: 700;
    margin-bottom: 4px;
  }

  .member-role {
    font-size: 14px;
    color: var(--color-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
