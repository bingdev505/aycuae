---
import { querySanity, urlFor } from '../utils/sanity';

const testimonialsQuery = `*[_type == "testimonial"]{
  clientName,
  role,
  quote,
  rating,
  image
}`;

const defaultTestimonials = [
  {
    clientName: 'Sarah Jenkins',
    role: 'CEO, Jenkins Logistics',
    quote: 'ConstX remodeled our main corporate headquarters. Their builders were professional, efficient, and finished ahead of schedule. Highly recommended!',
    rating: 5,
    image: null
  },
  {
    clientName: 'David Miller',
    role: 'Home Owner',
    quote: 'Excellent service! They redesigned our kitchen and built a modern garage addition. The cost was transparent and exactly matched the initial estimate.',
    rating: 5,
    image: null
  }
];

const testimonials = await querySanity(testimonialsQuery, defaultTestimonials);
---

<section class="testimonials-area" id="testimonials">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="sub-heading">Client Feedback</span>
      <h2 class="main-heading text-white">What Our Customers Say</h2>
    </div>

    <!-- Swiper Carousel -->
    <div class="swiper testimonials-swiper">
      <div class="swiper-wrapper">
        {testimonials.map((test) => {
          const userImg = test.image ? urlFor(test.image) : '/wp-content/uploads/2025/11/testimonial-user.jpg';
          return (
            <div class="swiper-slide">
              <div class="testimonial-card">
                <div class="rating-stars">
                  {Array.from({ length: test.rating || 5 }).map(() => (
                    <i class="fa-solid fa-star"></i>
                  ))}
                </div>
                <p class="testimonial-quote">"{test.quote}"</p>
                <div class="client-detail-box">
                  <div class="client-photo">
                    <img src={userImg} alt={test.clientName} />
                  </div>
                  <div class="client-meta-info">
                    <h4>{test.clientName}</h4>
                    <span>{test.role}</span>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <!-- Pagination -->
      <div class="swiper-pagination testimonials-pagination-dots"></div>
    </div>
  </div>
</section>

<style>
  .testimonials-area {
    padding: 100px 0;
    background: #090d16;
  }

  .testimonials-swiper {
    max-width: 800px;
    margin: 0 auto;
    padding-bottom: 50px;
  }

  .testimonial-card {
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 40px 30px;
    border-radius: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .rating-stars {
    color: #ff6900;
    font-size: 16px;
    margin-bottom: 20px;
    display: flex;
    gap: 5px;
  }

  .testimonial-quote {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 30px;
    font-style: italic;
  }

  .client-detail-box {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .client-photo img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #ff6900;
  }

  .client-meta-info {
    text-align: left;
  }

  .client-meta-info h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 18px;
    color: white;
    margin: 0;
  }

  .client-meta-info span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
  }

  .testimonials-pagination-dots {
    position: relative;
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    new Swiper('.testimonials-swiper', {
      slidesPerView: 1,
      spaceBetween: 30,
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.testimonials-pagination-dots',
        clickable: true,
      }
    });
  });
</script>
