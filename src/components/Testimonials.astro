---
import { siteData } from '../data/siteData';

const testimonials = siteData.testimonials;
---

<section class="testimonials-area" id="testimonials">
  <div class="container">
    <div class="row align-items-center">
      <!-- Section Headers -->
      <div class="col-lg-5 col-12 mb-5 mb-lg-0">
        <div class="section-title-box">
          <span class="sub-heading">OUR TESTIMONIALS</span>
          <h2 class="main-heading text-white">Real feedback from those who built their dreams</h2>
          <p class="about-description">Our commitment to excellence has earned us the trust of homeowners, developers and businesses alike.</p>
          <a href="/testimonials" class="btn-estimate mt-3">
            <span>View All Testimonials</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M16.8065 5.82872C14.3962 5.82872 12.1995 3.54151 12.1995 1.02981V0L10.2223 0V1.02981C10.2223 2.85669 10.9914 4.57028 12.1985 5.82872L0 5.82872L0 7.88833L12.1985 7.88833C10.9914 9.14676 10.2223 10.8604 10.2223 12.6872V13.717H12.1995V12.6872C12.1995 10.1755 14.3962 7.88833 16.8065 7.88833H17.7951V5.82872H16.8065Z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Testimonials Slides Column -->
      <div class="col-lg-7 col-12 ps-lg-5">
        <div class="swiper testimonials-swiper">
          <div class="swiper-wrapper">
            {testimonials.map((test) => (
              <div class="swiper-slide">
                <div class="testimonial-card">
                  <div class="client-logo-box mb-4">
                    <img src={test.companyLogo} alt="Company Logo" class="client-logo-img" />
                  </div>
                  <p class="testimonial-quote">“{test.quote}”</p>
                  <div class="client-meta-info mt-4">
                    <h4 class="client-name">{test.clientName}</h4>
                    <span class="client-role">{test.role}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <!-- Pagination -->
          <div class="swiper-pagination testimonials-pagination-dots"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-area {
    padding: 100px 0;
    background: #090d16;
  }

  .testimonials-swiper {
    width: 100%;
    padding-bottom: 50px;
  }

  .testimonial-card {
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 40px 30px;
    border-radius: 20px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .client-logo-img {
    height: 30px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.8;
  }

  .testimonial-quote {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    font-style: italic;
  }

  .client-meta-info {
    text-align: left;
  }

  .client-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 18px;
    color: white;
    margin: 0;
  }

  .client-role {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
  }

  .sub-heading {
    font-family: 'Space Grotesk', sans-serif;
    color: #ff6900;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 15px;
  }

  .main-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 25px;
  }

  .about-description {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 35px;
  }

  .btn-estimate {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ff6900;
    color: white;
    padding: 16px 35px;
    border-radius: 30px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 14px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .btn-estimate:hover {
    background: white;
    color: #1a1a1a;
  }

  .testimonials-pagination-dots {
    position: relative;
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  @media (max-width: 991px) {
    .main-heading {
      font-size: 32px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    new Swiper('.testimonials-swiper', {
      slidesPerView: 1,
      spaceBetween: 30,
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.testimonials-pagination-dots',
        clickable: true,
      },
      breakpoints: {
        768: {
          slidesPerView: 2,
        }
      }
    });
  });
</script>
