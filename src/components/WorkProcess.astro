---
const steps = [
  {
    number: '01',
    title: 'Architectural Plan',
    description: 'We draft blueprints and create detailed 3D models to visually map the layout.'
  },
  {
    number: '02',
    title: 'Cost Estimation',
    description: 'We calculate material expenses, hiring rates, and set a fixed optimized budget.'
  },
  {
    number: '03',
    title: 'Build Execution',
    description: 'Our certified builders perform core structural work adhering to security protocols.'
  },
  {
    number: '04',
    title: 'Client Handover',
    description: 'We run detailed checks, tidy up the site, and officially deliver the keys.'
  }
];
---

<section class="work-process-area">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="sub-heading">Execution Path</span>
      <h2 class="main-heading text-white">How We Build Projects</h2>
    </div>

    <div class="row">
      {steps.map((step, index) => (
        <div class="col-lg-3 col-md-6 col-12 mb-4 mb-lg-0">
          <div class="process-card">
            <div class="process-number-box">
              <span class="process-num">{step.number}</span>
            </div>
            <h3 class="process-title">{step.title}</h3>
            <p class="process-desc">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .work-process-area {
    padding: 100px 0;
    background: #090d16;
  }

  .section-title-box {
    margin-bottom: 50px;
  }

  .sub-heading {
    font-family: 'Space Grotesk', sans-serif;
    color: #ff6900;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 15px;
  }

  .main-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.2;
  }

  .process-card {
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 40px 30px;
    border-radius: 20px;
    text-align: center;
    transition: all 0.3s ease;
    height: 100%;
  }

  .process-card:hover {
    transform: translateY(-5px);
    border-color: #ff6900;
  }

  .process-number-box {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    transition: all 0.3s ease;
  }

  .process-num {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 20px;
    color: #ff6900;
  }

  .process-card:hover .process-number-box {
    background: #ff6900;
  }

  .process-card:hover .process-num {
    color: white;
  }

  .process-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 20px;
    color: white;
    margin-bottom: 15px;
  }

  .process-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  @media (max-width: 991px) {
    .main-heading {
      font-size: 32px;
    }
  }
</style>
