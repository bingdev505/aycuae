---
import { querySanity, urlFor } from '../utils/sanity';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const seoQuery = `*[_type == "siteSettings"][0]{
  siteTitle,
  metaDescription,
  metaKeywords,
  ogImage,
  googleAnalyticsId,
  metaPixelId,
  customHeaderScripts,
  customBodyScripts
}`;

const defaultSeo = {
  siteTitle: 'Renovex | Premium Construction & Home Renovation',
  metaDescription: 'Renovex is a premium, modern construction, renovation, and building contractor offering high-quality structural and design solutions.',
  metaKeywords: 'construction, renovation, builder, architect, design, contractor, engineering',
  ogImage: null,
  googleAnalyticsId: null,
  metaPixelId: null,
  customHeaderScripts: null,
  customBodyScripts: null
};

const seo = await querySanity(seoQuery, defaultSeo);

const { 
  title = seo.siteTitle || defaultSeo.siteTitle, 
  description = seo.metaDescription || defaultSeo.metaDescription 
} = Astro.props;

const ogImageUrl = seo.ogImage ? urlFor(seo.ogImage) : 'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1200&h=630&q=80';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://aycuae.pages.dev');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.metaKeywords || defaultSeo.metaKeywords} />
    <link rel="canonical" href={canonicalUrl.href} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts (Space Grotesk & DM Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap" />

    <!-- Renovex Core Stylesheet Stack -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/all.min.css" />
    <link rel="stylesheet" href="/css/css-variable.css" />
    <link rel="stylesheet" href="/css/style.css" />

    <!-- Google Analytics Integration -->
    {seo.googleAnalyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${seo.googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ gaId: seo.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Meta (Facebook) Pixel Integration -->
    {seo.metaPixelId && (
      <script is:inline define:vars={{ pixelId: seo.metaPixelId }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}

    <!-- Custom Header Scripts Dynamic Integration -->
    {seo.customHeaderScripts && <Fragment set:html={seo.customHeaderScripts} />}
  </head>
  <body class="home wp-singular page-template page-template-elementor_header_footer page page-id-67 wp-custom-logo wp-theme-renovex tt-magic-cursor fancy-scrollbar elementor-default elementor-template-full-width elementor-kit-13 elementor-page elementor-page-67">
    <!-- Meta Pixel NoScript Fallback -->
    {seo.metaPixelId && (
      <noscript>
        <img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${seo.metaPixelId}&ev=PageView&noscript=1`} />
      </noscript>
    )}

    <!-- Custom Body Scripts Dynamic Integration -->
    {seo.customBodyScripts && <Fragment set:html={seo.customBodyScripts} />}

    <!-- Theme Preloader -->
    <div class="theme-preloader">
      <div class="loading-container">
        <div class="loading"></div>
        <div id="loading-icon"><img src="/images/loader.svg" alt="Preloader" /></div>
      </div>
    </div>

    <!-- Magic Cursor -->
    <div id="magic-cursor">
      <div id="ball"></div>
    </div>

    <!-- Header -->
    <Header />
    
    <!-- Content slots -->
    <slot />

    <!-- Footer -->
    <Footer />

    <!-- Scripts stack -->
    <script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script is:inline src="/js/SmoothScroll.min.js"></script>
    <script is:inline src="/js/gsap.min.js"></script>
    <script is:inline src="/js/magiccursor.js"></script>
    <script is:inline src="/js/SplitText.js"></script>
    <script is:inline src="/js/ScrollTrigger.min.js"></script>
    <script is:inline src="/js/three.min.js"></script>
    <script is:inline>
      var theme_vars = {"theme_uri": ""};
    </script>
    <script is:inline src="/js/function.js"></script>
  </body>
</html>
