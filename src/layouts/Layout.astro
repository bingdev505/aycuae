---
import { siteData } from '../data/siteData';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = siteData.settings.siteTitle, 
  description = siteData.settings.footerAbout 
} = Astro.props;

const ogImageUrl = '/wp-content/uploads/2025/11/hero-bg.jpg';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://aycuae.pages.dev');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="construction, renovation, builder, architect, design, contractor, engineering" />
    <link rel="canonical" href={canonicalUrl.href} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts (Space Grotesk & DM Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap" />

    <!-- Renovex Core Stylesheet Stack -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/all.min.css" />
    <link rel="stylesheet" href="/css/css-variable.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="home wp-singular page-template page-template-elementor_header_footer page page-id-67 wp-custom-logo wp-theme-renovex tt-magic-cursor fancy-scrollbar elementor-default elementor-template-full-width elementor-kit-13 elementor-page elementor-page-67">
    
    <!-- Theme Preloader -->
    <div class="theme-preloader">
      <div class="loading-container">
        <div class="loading"></div>
        <div id="loading-icon"><img src="/images/loader.svg" alt="Preloader" /></div>
      </div>
    </div>

    <!-- Magic Cursor -->
    <div id="magic-cursor">
      <div id="ball"></div>
    </div>

    <!-- Header -->
    <Header />
    
    <!-- Content slots -->
    <slot />

    <!-- Footer -->
    <Footer />

    <!-- Scripts stack -->
    <script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script is:inline src="/js/SmoothScroll.min.js"></script>
    <script is:inline src="/js/gsap.min.js"></script>
    <script is:inline src="/js/magiccursor.js"></script>
    <script is:inline src="/js/SplitText.js"></script>
    <script is:inline src="/js/ScrollTrigger.min.js"></script>
    <script is:inline src="/js/three.min.js"></script>
    <script is:inline>
      var theme_vars = {"theme_uri": ""};
    </script>
    <script is:inline src="/js/function.js"></script>
    <script is:inline>
      // Failsafe to hide preloader after 1 second
      setTimeout(function() {
        var preloader = document.querySelector('.theme-preloader');
        if (preloader && preloader.style.display !== 'none') {
          preloader.style.transition = 'opacity 0.5s ease';
          preloader.style.opacity = '0';
          setTimeout(function() {
            preloader.style.display = 'none';
          }, 500);
        }
      }, 1000);
    </script>
    <VisualEditing />
  </body>
</html>
