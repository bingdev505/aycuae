---
import { querySanity, urlFor } from '../utils/sanity';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const seoQuery = `*[_type == "siteSettings"][0]{
  siteTitle,
  metaDescription,
  metaKeywords,
  ogImage,
  googleAnalyticsId,
  metaPixelId,
  customHeaderScripts,
  customBodyScripts
}`;

const defaultSeo = {
  siteTitle: 'ConstX | Premium Construction, Renovation & Building Contractor',
  metaDescription: 'ConstX is a premium, modern construction, renovation, and building contractor offering high-quality structural and design solutions.',
  metaKeywords: 'construction, renovation, builder, architect, design, contractor, engineering',
  ogImage: null,
  googleAnalyticsId: null,
  metaPixelId: null,
  customHeaderScripts: null,
  customBodyScripts: null
};

const seo = await querySanity(seoQuery, defaultSeo);

const { 
  title = seo.siteTitle || defaultSeo.siteTitle, 
  description = seo.metaDescription || defaultSeo.metaDescription 
} = Astro.props;

const ogImageUrl = seo.ogImage ? urlFor(seo.ogImage) : 'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1200&h=630&q=80';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://aycuae.pages.dev');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.metaKeywords || defaultSeo.metaKeywords} />
    <link rel="canonical" href={canonicalUrl.href} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Swiper CSS (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Google Analytics Integration -->
    {seo.googleAnalyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${seo.googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ gaId: seo.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Meta (Facebook) Pixel Integration -->
    {seo.metaPixelId && (
      <script is:inline define:vars={{ pixelId: seo.metaPixelId }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}

    <!-- Custom Header Scripts Dynamic Integration -->
    {seo.customHeaderScripts && <Fragment set:html={seo.customHeaderScripts} />}
  </head>
  <body>
    <!-- Meta Pixel NoScript Fallback -->
    {seo.metaPixelId && (
      <noscript>
        <img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${seo.metaPixelId}&ev=PageView&noscript=1`} />
      </noscript>
    )}

    <!-- Custom Body Scripts Dynamic Integration -->
    {seo.customBodyScripts && <Fragment set:html={seo.customBodyScripts} />}

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Swiper JS (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
  </body>
</html>

<style is:global>
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg-light);
  }
  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-primary);
  }
</style>
