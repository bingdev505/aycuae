---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';

const videos = [
  {
    title: 'Modern Renovation Walkthrough',
    youtubeUrl: 'https://www.youtube.com/watch?v=Y-x0efG1seA',
    thumbnail: '/wp-content/uploads/2025/11/project-image-1.jpg'
  },
  {
    title: 'Skyline Build Phase 1',
    youtubeUrl: 'https://www.youtube.com/watch?v=Y-x0efG1seA',
    thumbnail: '/wp-content/uploads/2025/11/project-image-2.jpg'
  },
  {
    title: 'Minimalist Interior Handover',
    youtubeUrl: 'https://www.youtube.com/watch?v=Y-x0efG1seA',
    thumbnail: '/wp-content/uploads/2025/11/project-image-3.jpg'
  }
];
---

<Layout title="Video Gallery - Renovex Construction and Architecture">
  <PageBanner title="Video Gallery" activePage="Video Gallery" />

  <section class="gallery-area">
    <div class="container">
      <div class="row">
        {videos.map((vid) => (
          <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="gallery-video-item">
              <div class="video-thumb-box">
                <img src={vid.thumbnail} alt={vid.title} class="img-fluid" />
                <a class="video-play-btn popup-youtube" href={vid.youtubeUrl} aria-label="Play video">
                  <i class="fas fa-play"></i>
                </a>
              </div>
              <div class="video-details-box mt-3 text-center">
                <h4 class="video-title">{vid.title}</h4>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .gallery-area {
    padding: 100px 0;
    background: #090d16;
  }

  .gallery-video-item {
    background: #151c28;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 15px;
    border-radius: 20px;
    transition: all 0.3s ease;
  }

  .gallery-video-item:hover {
    border-color: #ff6900;
  }

  .video-thumb-box {
    position: relative;
    overflow: hidden;
    border-radius: 15px;
  }

  .video-thumb-box img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #ff6900;
    color: white;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .video-play-btn:hover {
    background: white;
    color: #ff6900;
    transform: translate(-50%, -50%) scale(1.1);
  }

  .video-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 18px;
    color: white;
    margin: 5px 0 0 0;
  }
</style>
